# Riferimento delle variabili d'ambiente del progetto.
#
# IMPORTANTE — modalità di lavoro: tutto in cloud (Claude Code on the web,
# GitHub, Vercel, Supabase). Le credenziali NON si tengono in file .env locali:
# si impostano nei pannelli dei rispettivi servizi:
#
#   - Vercel  → Project Settings → Environment Variables
#               (NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#                SUPABASE_SERVICE_ROLE_KEY, NEXT_PUBLIC_APP_URL)
#   - Supabase → Project Settings → Auth/API
#               (lì leggi i valori da copiare in Vercel; il service role NON
#                deve mai uscire dal lato server)
#   - Claude Code on the web → Environment → Environment Variables
#               (per esecuzioni una tantum come `npm run bootstrap`)
#
# Questo file resta a titolo di documentazione del set richiesto.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mai esporre al browser: usata solo da route server e dallo script bootstrap.
SUPABASE_SERVICE_ROLE_KEY=

# URL pubblico dell'app (QR degli attestati, link LinkedIn). Default: produzione.
NEXT_PUBLIC_APP_URL=https://fad-wine.vercel.app

# Nessun tenant da env: l'app lo deriva dalla persona autenticata. Gli enti si
# creano con `npm run nuovo-ente` (il seed demo usa BOOTSTRAP_TENANT_ID).

# Fase 6 — vendita dei corsi (Stripe Checkout). Solo lato server, mai in repo né
# in chat: Vercel → Environment Variables (chiavi di TEST su Preview, LIVE su
# Production quando si vende davvero). Senza, acquisto e webhook rispondono 503.
STRIPE_SECRET_KEY=
# Firma del webhook: Stripe → Developers → Webhooks → endpoint
# https://<indirizzo>/api/stripe/webhook con gli eventi checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# checkout.session.expired, charge.refunded.
STRIPE_WEBHOOK_SECRET=
